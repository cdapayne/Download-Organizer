{
  "manifest_version": 3,
  "name": "Download Organizer",
  "version": "1.0.0",
  "description": "Organize your downloads into categories. When a download starts, choose or create a folder category — files are saved automatically to that subfolder.",
  "permissions": [
    "downloads",
    "storage",
    "windows"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download Organizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
